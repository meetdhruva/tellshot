[Desktop Entry]
Type=Application
Name=Tellshot
GenericName=Screenshot Editor
Comment=Capture, annotate and share screenshots
Exec=tellshot-editor %f
Icon=io.github.meetdhruva.Tellshot
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;Utility;
Keywords=screenshot;capture;annotate;redact;snip;
MimeType=application/x-tellshot;image/png;
StartupWMClass=tellshot-editor
