// Accessible building blocks. Every interactive control:
//   * has an accessible role and a label (UI tests fail otherwise),
//   * is reachable with Tab and activates with Enter/Space,
//   * draws a visible focus ring,
//   * is at least Theme.target-size in both dimensions.

import { Theme } from "theme.slint";

// A square toggle button with a stroked 24×24 icon path and a tooltip-like label.
export component ToolButton inherits Rectangle {
    in property <string> label;
    in property <string> shortcut;
    in property <string> icon;
    in property <bool> active;
    in property <bool> enabled: true;
    // Toggle buttons (tools) report checked state; action buttons (undo, save) do not.
    in property <bool> toggle: true;
    callback clicked();

    width: Theme.target-size;
    height: Theme.target-size;
    border-radius: Theme.radius;
    background: root.active ? Theme.accent : (touch.has-hover ? Theme.surface : transparent);
    border-width: focus.has-focus ? Theme.focus-width : 0px;
    border-color: Theme.focus-ring;
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: Theme.motion-fast; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.shortcut == "" ? "" : "Shortcut " + root.shortcut;
    accessible-checkable: root.toggle;
    accessible-checked: root.toggle && root.active;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    Path {
        width: 20px;
        height: 20px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.active ? Theme.on-accent : Theme.text;
        stroke-width: 1.75px;
        fill: transparent;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.clicked(); }
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// A colour swatch. The label is the colour's name, never just the colour.
export component Swatch inherits Rectangle {
    in property <string> label;
    in property <color> swatch;
    in property <bool> active;
    callback clicked();

    width: Theme.target-size;
    height: Theme.target-size;
    border-radius: Theme.target-size / 2;
    background: root.swatch;
    border-width: root.active || focus.has-focus ? 3px : Theme.border-width;
    border-color: root.active || focus.has-focus ? Theme.focus-ring : Theme.border;

    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }

    TouchArea { clicked => { focus.focus(); root.clicked(); } }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// Lucide-style icon paths (24×24 viewbox, stroked). Drawn here, so no asset licensing.
export global Icons {
    out property <string> select: "M5 3 L5 19 L9.5 14.5 L12.5 21 L15 20 L12 13.5 L18 13.5 Z";
    out property <string> arrow: "M5 19 L19 5 M10 5 L19 5 L19 14";
