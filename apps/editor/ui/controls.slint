    out property <string> ellipse: "M12 5 C17 5 21 8 21 12 C21 16 17 19 12 19 C7 19 3 16 3 12 C3 8 7 5 12 5 Z";
    out property <string> text: "M5 6 L5 4 L19 4 L19 6 M12 4 L12 20 M9 20 L15 20";
